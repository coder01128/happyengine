{
  "name": "happyengine",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p app",
    "eval": "node eval/run.ts",
    "eval:contracts": "node eval/contracts/run.ts",
    "synth": "node eval/synth/generate.ts",
    "smoke": "node scripts/smoke.ts",
    "seed": "node scripts/seed-local.ts",
    "app": "npm run dev -w @happy/app"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^24.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  }
}
