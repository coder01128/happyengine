{
  "service": "Happy Contracts",
  "version": 1,
  "parser": { "tier": "cost_effective", "scannedTier": "agentic", "maxPagesPerAgreement": 60, "versions": { "cost_effective": "2026-09-28", "agentic": "2026-09-29", "agentic_plus": "2026-09-28" } },
  "grounding": { "minScore": 0.9, "ignoreTokens": ["sample", "copy", "draft", "specimen"] },
  "fields": [
    { "key": "counterparty", "label": "Counterparty", "required": false },
    { "key": "agreementType", "label": "Agreement type", "required": false, "descriptive": true },
    { "key": "premises", "label": "Premises", "required": false },
    { "key": "startDate", "label": "Start", "required": false },
    { "key": "endDate", "label": "End", "required": false },
    { "key": "termMonths", "label": "Term", "required": false },
    { "key": "renewal", "label": "Renewal", "required": false },
    { "key": "notice", "label": "Notice", "required": false },
    { "key": "fee", "label": "Fee", "required": false },
    { "key": "feeChange", "label": "Fee changes", "required": false },
    { "key": "deposit", "label": "Deposit", "required": false },
    { "key": "scope", "label": "Scope", "required": false, "descriptive": true },
    { "key": "agreementCategory", "label": "Category", "required": false, "repeatedQuoteOk": true }
  ],
  "categories": [
    { "id": "lease", "label": "Lease", "required": ["renewal", "notice", "endDate"], "confirm": false },
    { "id": "licence", "label": "Licence", "required": ["renewal", "notice", "endDate"], "confirm": false },
    { "id": "loan", "label": "Loan", "required": [], "confirm": true },
    { "id": "nda", "label": "Non-disclosure agreement", "required": [], "confirm": true },
    { "id": "order", "label": "Once-off order", "required": [], "confirm": true },
    { "id": "other", "label": "Other", "required": ["renewal", "notice", "endDate"], "confirm": false },
    { "id": "poa", "label": "Power of attorney", "required": [], "confirm": true },
    { "id": "rental", "label": "Rental", "required": ["renewal", "notice", "endDate"], "confirm": false },
    { "id": "sale", "label": "Sale or purchase", "required": [], "confirm": true },
    { "id": "service", "label": "Service", "required": ["renewal", "notice", "endDate"], "confirm": false },
    { "id": "settlement", "label": "Settlement", "required": [], "confirm": true },
    { "id": "subscription", "label": "Subscription", "required": ["renewal", "notice", "endDate"], "confirm": false }
  ],
  "uncategorised": { "required": ["renewal", "notice", "endDate"] },
  "alertWindows": { "attention": 30, "upcoming": 90 },
  "reviewOptions": [
    { "id": "confirm", "label": "Confirm recorded value", "outcome": "reviewed", "singleValueOnly": true },
    { "id": "legal", "label": "Refer to legal review", "outcome": "with_legal", "singleValueOnly": false },
    { "id": "clarify", "label": "Request clarification from counterparty", "outcome": "reviewed", "singleValueOnly": false }
  ],
  "presetSearches": [
    { "id": "auto", "question": "Which agreements renew or continue automatically?", "kind": "fieldTag", "tag": "auto" },
    { "id": "notice", "question": "Which notice deadlines fall on or before {before}?", "kind": "datesBefore", "tag": "notice", "beforeDays": 90 },
    { "id": "fees", "question": "Which fees change during the term or on renewal?", "kind": "fieldTag", "tag": "fee-change" },
    { "id": "review", "question": "Which terms are up for review?", "kind": "review" }
  ],
  "reminders": {
    "to": "Office manager",
    "subject": "Contract dates in the next {upcoming} days (register as at {asAt})",
    "intro": "The following dates from the contract register fall within the next {upcoming} days:",
    "item": "{n}. {date} ({days}) — {counterparty}, {type} ({ref})\n   {label}: {what} ({clause}).",
    "outro": "Dates are calculated from the recorded wording. The signed agreement is the source of truth.",
    "empty": "No contract dates fall within the next {upcoming} days."
  }
}
