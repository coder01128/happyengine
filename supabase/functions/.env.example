# Secrets for edge functions and Node scripts. Copy to supabase/functions/.env (git-ignored) and fill in.
# Node scripts load this file with process.loadEnvFile; `supabase functions serve` reads it too.
LLAMA_CLOUD_API_KEY=
# EU region. Keys are region-specific: a North America key is rejected here.
LLAMA_CLOUD_BASE_URL=https://api.cloud.eu.llamaindex.ai
ANTHROPIC_API_KEY=
# Required, no default. For example: claude-opus-5-5
ANTHROPIC_MODEL=
